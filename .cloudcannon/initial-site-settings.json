{
  "ssg": "hugo",
  "mode": "hosted",
  "build": {
    "install_command": "npm i",
    "build_command": "npm run build",
    "output_path": "public",
    "hugo_version": "0.166.0",
    "preserved_paths": "node_modules/,resources/,.hugo_cache/",
    "environment_variables": [
      {
        "key": "HUGO_CACHEDIR",
        "value": "/usr/local/__site/src/.hugo_cache/"
      },
      {
        "key": "CLOUDCANNON_SYNC_PATHS",
        "value": "/rosey/"
      }
    ]
  }
}
